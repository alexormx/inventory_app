<%= render 'checkouts/progress_bar', current_step: 1 %>

<%# Los productos se ven en el resumen (primero en móvil); este paso solo
    pide el nombre, si falta, y las notas del pedido. %>
<div class="row gy-4">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="mb-0">Datos del pedido</h4>
      <%= link_to cart_path, class: 'btn btn-sm btn-outline-secondary' do %>
        <i class="fa fa-pencil me-1"></i> Editar carrito
      <% end %>
    </div>

    <% if @cart.empty? %>
      <div class="alert alert-info">
        <i class="fa fa-info-circle me-2"></i>
        Tu carrito está vacío. <%= link_to 'Ver catálogo', products_path %>.
      </div>
    <% else %>
      <%= form_with url: checkout_step1_path, method: :post, local: true do %>
        <% if current_user.name.blank? %>
          <div class="card mb-4">
            <div class="card-header bg-light">
              <h6 class="mb-0"><i class="fa fa-user me-2"></i>¿A nombre de quién es el pedido?</h6>
            </div>
            <div class="card-body">
              <%= label_tag :customer_name, 'Nombre completo', class: 'form-label small text-muted' %>
              <%= text_field_tag :customer_name, params[:customer_name], required: true, maxlength: 255,
                                 autocomplete: 'name', class: 'form-control' %>
            </div>
          </div>
        <% end %>

        <div class="card mb-4">
          <div class="card-header bg-light">
            <h6 class="mb-0"><i class="fa fa-comment me-2"></i>Notas adicionales (opcional)</h6>
          </div>
          <div class="card-body">
            <%= label_tag :notes, 'Notas del pedido (opcional)', class: 'form-label small text-muted' %>
<%= text_area_tag :notes, @checkout_notes, rows: 2, maxlength: CheckoutSessionHelper::MAX_NOTES, class: "form-control", placeholder: "Instrucciones especiales, comentarios sobre tu pedido..." %>
          </div>
        </div>

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2">
          <%= link_to cart_path, class: 'btn btn-outline-secondary' do %>
            <i class="fa fa-arrow-left me-1"></i> Volver al carrito
          <% end %>
          <%= submit_tag "Continuar con envío →", class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="col-lg-4 order-first order-lg-last">
    <%= render 'checkouts/cart_summary', cart: @cart %>
  </div>
</div>
