<footer class="text-center bg-light py-3 mt-5">
  <p>
    © <%= Time.current.year %> Pasatiempos. Todos los derechos reservados.
    &nbsp;|&nbsp;
    <%# El blog solo se enlaza cuando tiene publicaciones; vacío se veía abandonado. %>
    <% if Rails.cache.fetch('footer/blog_has_posts', expires_in: 10.minutes) { Post.visible.exists? } %>
      <%= link_to "Blog", blog_path, class: "text-decoration-none" %>
      &nbsp;|&nbsp;
    <% end %>
    <%= link_to "Aviso de Privacidad", privacy_notice_path, class: "text-decoration-none" %>
    &nbsp;|&nbsp;
    <%= link_to "Términos y Condiciones", terms_path, class: "text-decoration-none" %>
  </p>
</footer>