<%# cuerpo interno del preview (reemplazable) %>
<div class="cart-preview-header d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
  <div class="d-flex align-items-center">
    <strong>Carrito</strong>
    <%# cart_obj.items devuelve un array de hashes; sumamos las cantidades %>
    <% items_count = cart_obj.items.sum { |item| item[:quantity].to_i } %>
    <span class="cart-preview-count" aria-label="Total de unidades en el carrito"><%= items_count %></span>
  </div>
  <button type="button" class="btn-close cart-preview-close" data-cart-preview-close aria-label="Cerrar mini carrito"></button>
</div>
<% if cart_obj.items.any? %>
  <div class="cart-preview-scroll">
  <ul class="list-unstyled mb-2">
    <% cart_obj.items.each do |item| %>
      <% product = item[:product] %>
      <% qty = item[:quantity] %>
      <% item_price = item[:price] %>
      <% condition = item[:condition] %>
      <% collectible = item[:collectible] %>
      <li class="d-flex align-items-center mb-2 cart-preview-item" id="cart_item_<%= product.id %>_<%= condition %>">
        <div class="cart-preview-media me-2 flex-shrink-0">
          <% if product.product_images.attached? %>
            <%= image_tag product.primary_product_image.variant(resize_to_fill: [40,40]), alt: product.product_name, class: 'rounded border cart-preview-thumb' %>
          <% else %>
            <div class="cart-preview-thumb placeholder d-flex align-items-center justify-content-center rounded border"> <i class="fas fa-box-open text-muted"></i></div>
          <% end %>
        </div>
        <div class="cart-preview-item-content flex-grow-1 me-2">
          <div class="fw-medium small line-clamp-1">
            <%= product.product_name %>
            <% if collectible %>
              <i class="fas fa-gem text-warning" title="<%= item[:label] %>"></i>
            <% end %>
          </div>
          <% on_hand = product.current_on_hand(condition: condition) %>
          <% in_transit = product.in_transit_count(condition: condition) %>
          <% available_count = on_hand + in_transit %>
          <div class="d-flex flex-wrap align-items-center gap-1 mb-1">
            <% if collectible %>
              <span class="badge bg-warning-subtle text-warning"><%= item[:label] %></span>
            <% end %>
            <%= stock_badge(product, quantity: qty, condition: condition, suppress_pending_note: false, on_hand_override: on_hand, in_transit_override: in_transit) %>
          </div>
          <% if (eta = stock_eta(product, condition: condition, on_hand_override: on_hand)) %>
            <div class="small text-muted mb-1"><i class="fa fa-clock me-1" aria-hidden="true"></i><%= eta %></div>
          <% end %>
          <div class="cart-preview-quantity-line text-muted small d-flex align-items-center gap-2">
            <% if collectible %>
              <span class="small">1 pieza única</span>
            <% else %>
              <%= form_with url: cart_item_path(product), method: :patch, data: { turbo_frame: "_top" }, class: 'd-inline-flex align-items-center cart-mini-qty-form' do %>
                <input type="hidden" name="product_id" value="<%= product.id %>">
                <input type="hidden" name="condition" value="<%= condition %>">
                <button class="btn btn-sm btn-outline-secondary cart-mini-decrease" name="quantity" value="<%= qty - 1 %>" <%= 'disabled' if qty <= 1 %> aria-label="Disminuir cantidad de <%= product.product_name %>">−</button>
                <span class="cart-mini-qty-current mx-1 small"><%= qty %></span>
                <% disabled_inc = (available_count <= qty.to_i && !product.oversell_allowed?) || qty >= cart_obj.max_allowed(condition) %>
                <button class="btn btn-sm btn-outline-secondary cart-mini-increase <%= 'disabled' if disabled_inc %>" name="quantity" value="<%= qty + 1 %>" aria-label="Aumentar cantidad de <%= product.product_name %>" <%= 'disabled' if disabled_inc %>>+</button>
              <% end %>
            <% end %>
            <span>· <%= number_to_currency(item_price * qty) %></span>
          </div>
        </div>
        <div class="cart-preview-item-actions d-flex flex-column align-items-end gap-1">
          <div class="small fw-semibold text-nowrap"><%= number_to_currency(item_price) %></div>
          <%= button_to cart_item_path(product), method: :delete, params: { product_id: product.id, condition: condition }, form: { class: 'm-0 p-0' }, class: 'btn btn-sm btn-link text-danger cart-preview-remove', title: "Eliminar #{product.product_name}", aria: { label: "Eliminar #{product.product_name} del carrito" } do %>
            <i class="fas fa-times" aria-hidden="true"></i>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
  </div>
  <div class="cart-preview-footer mt-2 border-top pt-2 flex-shrink-0">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="small text-muted">Total</span>
      <strong><%= number_to_currency(cart_obj.total) %></strong>
    </div>
    <%= link_to 'Ver carrito', cart_path, class: 'btn btn-sm btn-primary w-100 cart-preview-cta', data: { turbo_frame: '_top' } %>
  </div>
<% else %>
  <div class="cart-preview-empty flex-grow-1 d-flex flex-column align-items-center justify-content-center">
    <div class="icon text-muted"><i class="fas fa-shopping-basket"></i></div>
    <div class="text-muted small mb-2">Tu carrito está vacío</div>
    <%= link_to 'Explorar productos', catalog_path, class: 'btn btn-outline-primary btn-sm cta', data: { turbo_frame: '_top' } %>
  </div>
<% end %>
