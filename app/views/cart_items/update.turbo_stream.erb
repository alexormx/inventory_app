<% unless flash.now[:alert].present? %>
  <%= turbo_stream.update "cart-count", cart_item_count %>

  <%= turbo_stream.replace "cart-preview-body" do %>
    <div id="cart-preview-body">
      <%= render 'customers/partials/cart_preview_body', cart_obj: (@cart || Cart.new(session)) %>
    </div>
  <% end %>
<% end %>

<!-- Mensaje accesible opcional (live region dentro del preview) -->
<%= turbo_stream.append "flash-stack" do %>
  <% if flash.now[:alert].present? || flash.now[:notice].present? %>
    <% kind = flash.now[:alert].present? ? :alert : :notice %>
    <div class="alert <%= bootstrap_class_for(kind) %> flash-message" role="alert" data-timeout="4000"><%= flash.now[kind] %></div>
  <% end %>
<% end %>
