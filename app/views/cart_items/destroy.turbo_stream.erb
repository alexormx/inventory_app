<!-- Eliminación de item en carrito -->
<%= turbo_stream.replace 'cart-count', partial: 'customers/partials/cart_count', locals: { count: cart_item_count } %>

<%= turbo_stream.replace "cart-preview-body" do %>
  <div id="cart-preview-body">
    <%= render 'customers/partials/cart_preview_body', cart_obj: (@cart || current_cart) %>
  </div>
<% end %>
