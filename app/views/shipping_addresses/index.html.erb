<% content_for :title do %>Mis direcciones - Pasatiempos a Escala<% end %>

<div class="account-page container py-4">
  <%= render 'customers/partials/account_nav' %>

  <h1 class="h4 mb-3">Mis direcciones</h1>

  <div class="row g-4">
    <div class="col-md-6">
      <h2 class="h6 text-muted mb-2">Guardadas</h2>
      <% if @addresses.any? %>
        <ul class="list-group shadow-sm">
          <% @addresses.each do |addr| %>
            <li class="list-group-item py-3">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="min-w-0">
                  <strong><%= addr.label %></strong>
                  <% if addr.default? %><span class="badge bg-success ms-1">Principal</span><% end %>
                  <div class="small"><%= addr.full_name %></div>
                  <div class="small text-muted"><%= addr.to_one_line %></div>
                </div>
                <%= link_to 'Editar', edit_shipping_address_path(addr), class: 'btn btn-sm btn-outline-secondary flex-shrink-0' %>
              </div>
              <div class="d-flex gap-2 mt-2">
                <% unless addr.default? %>
                  <%= button_to 'Hacer principal', make_default_shipping_address_path(addr), method: :patch, class: 'btn btn-sm btn-outline-primary' %>
                <% end %>
                <%= button_to 'Eliminar', shipping_address_path(addr), method: :delete,
                              data: { controller: 'confirm', action: 'click->confirm#ask', confirm_title: 'Eliminar dirección', confirm_message: 'Esta dirección dejará de estar disponible para futuras compras. ¿Deseas continuar?', confirm_confirm_label: 'Eliminar dirección' },
                              class: 'btn btn-sm btn-outline-danger' %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-muted">Aún no tienes direcciones guardadas.</p>
      <% end %>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h2 class="h6 mb-0"><i class="fa-solid fa-plus me-2" aria-hidden="true"></i>Agregar dirección</h2>
        </div>
        <div class="card-body">
          <%= render 'form', address: @address %>
        </div>
      </div>
    </div>
  </div>
</div>
