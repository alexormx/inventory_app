<% content_for :title do %>Correo y contraseña - Pasatiempos a Escala<% end %>

<div class="account-page container py-4">
  <%= render 'customers/partials/account_nav' %>

  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-light">
          <h1 class="h5 mb-0"><i class="fas fa-key me-2" aria-hidden="true"></i><%= t('.title') %></h1>
        </div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, class: 'form-label' %>
              <%= f.email_field :email, autocomplete: "email", class: 'form-control' %>
              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <div class="form-text"><%= t('.currently_waiting_confirmation_for_email', email: resource.unconfirmed_email) %></div>
              <% end %>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-md-6">
                <%= f.label :password, 'Contraseña nueva', class: 'form-label' %>
                <%= f.password_field :password, autocomplete: "new-password", class: 'form-control' %>
                <div class="form-text">
                  Opcional: <%= t('.leave_blank_if_you_don_t_want_to_change_it') %>.
                  <% if @minimum_password_length %>
                    <%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %>
                  <% end %>
                </div>
              </div>
              <div class="col-md-6">
                <%= f.label :password_confirmation, 'Confirma la contraseña nueva', class: 'form-label' %>
                <%= f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control' %>
              </div>
            </div>

            <div class="mb-4">
              <%= f.label :current_password, class: 'form-label' %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: 'form-control', required: true %>
              <div class="form-text">Obligatoria: <%= t('.we_need_your_current_password_to_confirm_your_changes') %>.</div>
            </div>

            <hr>

            <div class="d-flex flex-column-reverse flex-sm-row justify-content-between gap-2">
              <%= link_to 'Cancelar', profile_path, class: "btn btn-outline-secondary" %>
              <%= f.submit t('.update'), class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="card shadow-sm mt-4 border-danger-subtle">
        <div class="card-header bg-light">
          <h2 class="h6 mb-0 text-danger"><i class="fas fa-triangle-exclamation me-2" aria-hidden="true"></i><%= t('.cancel_my_account') %></h2>
        </div>
        <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
          <p class="text-muted small mb-0"><%= t('.unhappy') %></p>
          <%= button_to t('.cancel_my_account'), registration_path(resource_name),
                        method: :delete,
                        class: 'btn btn-outline-danger flex-shrink-0',
                        data: { controller: 'confirm', action: 'click->confirm#ask', confirm_title: t('.cancel_my_account'), confirm_message: t('.are_you_sure'), confirm_confirm_label: t('.cancel_my_account') } %>
        </div>
      </div>
    </div>
  </div>
</div>
