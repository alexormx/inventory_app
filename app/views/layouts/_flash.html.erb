<%# Los avisos de error ya no se cierran solos, así que un panel fijo abajo a la
     derecha se quedaba encima de los botones de acción (que en este admin van
     alineados a la derecha) y los volvía inclicables. Se mueve a la izquierda y
     el contenedor deja pasar los clics; cada mensaje sí los recibe. %>
<div id="flash-stack" class="flash-stack position-fixed" style="z-index:1300; width:min(360px,90vw); bottom:1rem; left:1rem; display:flex; flex-direction:column; align-items:stretch; pointer-events:none;">
  <% flash.each do |key, message| %>
    <%= render 'layouts/flash_message', key: key, message: message %>
  <% end %>
</div>
