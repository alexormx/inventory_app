<div id="flash-stack" class="flash-stack position-fixed" style="z-index:1300; width:min(360px,90vw); bottom:1rem; right:1rem; display:flex; flex-direction:column; align-items:stretch;">
  <% flash.each do |key, message| %>
    <%= render 'layouts/flash_message', key: key, message: message %>
  <% end %>
</div>
