<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      margin: 0;
      padding: 0;
    }
    .email-container {
      max-width: 600px;
      margin: 30px auto;
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 8px rgba(0, 0, 0, 0.05);
      padding: 30px;
    }
    h1 {
      font-size: 24px;
      color: #dc3545;
      text-align: center;
      margin-bottom: 20px;
    }
    p {
      font-size: 16px;
      line-height: 1.5;
      color: #333;
      margin-bottom: 20px;
      text-align: center;
    }
    .btn {
      display: inline-block;
      background-color: #dc3545;
      color: #fff;
      padding: 14px 24px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: bold;
      text-align: center;
    }
    .footer {
      font-size: 14px;
      color: #888;
      text-align: center;
      margin-top: 40px;
    }
    .order-email-container { max-width: 600px; margin: 0 auto; }
    .order-email-header { background-color: #007bff; color: white; padding: 20px; text-align: center; }
    .order-email-content { padding: 20px; background-color: #f9f9f9; }
    .order-email-summary { background-color: white; padding: 15px; margin: 20px 0; border-radius: 5px; }
    .order-email-item { border-bottom: 1px solid #eee; padding: 10px 0; }
    .order-email-item:last-child { border-bottom: none; }
    .order-email-total { font-weight: bold; font-size: 1.2em; text-align: right; padding-top: 15px; border-top: 2px solid #007bff; }
    .order-email-address { background-color: #fff; padding: 15px; margin: 15px 0; border-left: 4px solid #007bff; }
    .order-email-footer { text-align: center; padding: 20px; color: #777; font-size: 0.9em; }
  </style>
</head>
<body>
  <div class="email-container">
    <div style="text-align: center; margin-bottom: 20px;">
      <%= image_tag "https://pasatiempos.com.mx/logo.png", alt: "Logo", style: "max-width: 100px; height: auto; width: 100%;" %>
      <h2><%= Rails.configuration.app_name.upcase %></h2>
    </div>

    <%= yield %>

    <div class="footer">
      <p>© <%= Date.current.year %> <%= Rails.configuration.app_name %>. Todos los derechos reservados.</p>
    </div>
  </div>
</body>
</html>
