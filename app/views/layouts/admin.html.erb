<!DOCTYPE html>
<html lang="es" class="admin-page">
<head>
  <title>Admin Dashboard</title>
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= favicon_link_tag 'favicon.ico' %>
  <%= favicon_link_tag 'favicon.svg', type: 'image/svg+xml' %>
  <link rel="apple-touch-icon" href="/favicon.ico">

  <!-- No-flash sidebar state: apply class ASAP based on localStorage -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('sidebar-collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (_) { /* ignore */ }
    })();
  </script>

  <!-- Styles & Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-d9hj8..." crossorigin="anonymous" referrerpolicy="no-referrer" />
  <%= stylesheet_link_tag "application", "admin_pack", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_include_tag "admin", "data-turbo-track": "reload", defer: true %>

  <%# Page-specific heavy bundles (charts/rich-text) load only where needed %>
  <%= yield(:head) if content_for?(:head) %>
</head>

<body class="admin-shell d-flex flex-column min-vh-100 bg-light">
  <%= turbo_stream_from "flash" %>
  <%= turbo_stream_from "audit_progress_channel" %>

  <div class="admin-layout">
    <!-- Sidebar -->
    <aside id="sidebar" class="text-white border-end" aria-label="Panel de navegación administrativa">
      <%= render "admin/partials/sidebar" %>
    </aside>

    <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true" hidden></div>

    <!-- Main Content -->
    <div id="admin-content" class="admin-content d-flex flex-column">

        <!-- Navbar with toggle -->
        <%= render "admin/partials/navbar" %>

  <!-- Flash messages dentro del container-fluid -->
  <%= render "layouts/flash" %>

        <main class="admin-main flex-grow-1 p-3 p-lg-4">
          <%= yield %>
        </main>

        <%= render "admin/partials/footer" %>
    </div>
  </div>
  <%= render "layouts/confirm_modal" %>
</body>
</html>
