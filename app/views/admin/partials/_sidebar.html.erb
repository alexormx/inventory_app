<div class="sidebar-inner d-flex flex-column">
  <%# Header minimalista %>
  <div class="sidebar-header px-2 py-2 border-bottom border-secondary-subtle">
    <div class="d-flex justify-content-between align-items-center">
      <a href="<%= admin_dashboard_path %>" class="text-decoration-none d-flex align-items-center gap-2 sidebar-brand-link" aria-label="Ir al panel de control">
        <span class="sidebar-brand-mark">
          <i class="fa-solid fa-store" aria-hidden="true"></i>
        </span>
        <span class="sidebar-label">
          <span class="fw-bold text-white small d-block">Pasatiempos</span>
          <span class="sidebar-brand-subtitle">Panel administrativo</span>
        </span>
      </a>
      <button type="button"
              class="sidebar-toggle-btn btn btn-sm btn-outline-light d-none d-lg-inline-flex"
              aria-label="Colapsar navegación"
              aria-controls="sidebar"
              aria-expanded="true"
              data-sidebar-desktop-toggle>
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <button type="button"
              class="sidebar-toggle-btn sidebar-drawer-close-btn btn btn-sm btn-outline-light d-inline-flex d-lg-none"
              aria-label="Cerrar navegación"
              aria-controls="sidebar"
              aria-expanded="false"
              data-sidebar-drawer-close>
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
  </div>

  <%# Navegación principal %>
  <nav class="sidebar-nav flex-grow-1 py-1" aria-label="Navegación administrativa">
    <ul class="nav flex-column">
      <% badges = admin_sidebar_badges %>

      <li class="sidebar-section-title px-3 pt-2 pb-1">Resumen</li>

      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Panel de control', admin_dashboard_path, icon: 'gauge-high', section: true %>
      </li>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Ventas</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Órdenes de venta', admin_sale_orders_path, icon: 'receipt', section: true %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Alertas de órdenes', admin_order_alerts_path, icon: 'triangle-exclamation', section: true,
                               badge: badges[:order_alerts] %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Carritos', admin_shopping_carts_path, icon: 'cart-shopping', section: true %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Preórdenes', admin_preorders_path, icon: 'calendar-check', section: true,
                               also: [admin_preorders_audit_path], badge: badges[:preorders] %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Pedidos WhatsApp', admin_whatsapp_requests_path, icon: 'comment-dots', section: true,
                               badge: badges[:whatsapp] %>
      </li>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Cuentas por cobrar', admin_receivables_path, icon: 'hand-holding-dollar' %>
      </li>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Compras</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Órdenes de compra', admin_purchase_orders_path, icon: 'truck-loading', section: true %>
      </li>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Catálogo del proveedor', admin_supplier_catalog_items_path, icon: 'arrows-rotate', section: true,
                               also: [admin_supplier_catalog_review_path] %>
      </li>
      <% if admin_sidebar_open?(admin_supplier_catalog_items_path, admin_supplier_catalog_review_path) %>
        <li class="nav-item px-2 ps-4 mb-1">
          <%= admin_sidebar_link 'Descubrir nuevos productos', discovery_admin_supplier_catalog_items_path, icon: 'magnifying-glass',
                                 also: [discovery_progress_admin_supplier_catalog_items_path] %>
        </li>
      <% end %>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Catálogo</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Productos', admin_products_path, icon: 'box-open', section: true,
                               also: [admin_catalog_review_path, admin_favorites_path] %>
      </li>
      <% if admin_sidebar_open?(admin_products_path, admin_catalog_review_path, admin_favorites_path) %>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Vinculación catálogo', catalog_status_admin_products_path, icon: 'link', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Revisión catálogo', admin_catalog_review_path, icon: 'clipboard-check', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Favoritos de clientes', admin_favorites_path, icon: 'heart', section: true %>
        </li>
      <% end %>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Coleccionables', admin_collectibles_path, icon: 'gem', section: true %>
      </li>
      <% if admin_sidebar_open?(admin_collectibles_path) %>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Agregar coleccionable', admin_collectibles_quick_add_path, icon: 'plus', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Guías de búsqueda', admin_collectible_lookup_sources_path, icon: 'compass', section: true %>
        </li>
      <% end %>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Enriquecimiento IA', admin_product_enrichment_index_path, icon: 'wand-magic-sparkles', section: true,
                               also: [admin_category_attribute_templates_path] %>
      </li>
      <% if Rails.env.development? %>
        <li class="nav-item px-2 mb-1">
          <%= admin_sidebar_link 'Generar catálogo PDF', admin_catalog_pdf_path, icon: 'file-pdf' %>
        </li>
      <% end %>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Inventario</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Inventario', admin_inventory_path, icon: 'boxes-stacked', section: true,
                               also: [admin_inventory_verifications_path] %>
      </li>
      <% if admin_sidebar_open?(admin_inventory_path, admin_inventory_verifications_path) %>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Sin ubicación', admin_inventory_unlocated_path, icon: 'location-crosshairs', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Explorar ubicaciones', admin_inventory_location_explorer_path, icon: 'compass', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Verificación física', admin_inventory_verifications_path, icon: 'list-check', section: true %>
        </li>
        <li class="nav-item px-2 ps-4">
          <%= admin_sidebar_link 'Transferir', admin_inventory_transfer_path, icon: 'right-left', section: true %>
        </li>
      <% end %>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Ajustes', admin_inventory_adjustments_path, icon: 'scale-balanced', section: true %>
      </li>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Ubicaciones', admin_inventory_locations_path, icon: 'sitemap', section: true,
                               also: [admin_location_types_path] %>
      </li>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Clientes y contenido</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Usuarios', admin_users_path, icon: 'users', section: true %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Blog', admin_posts_path, icon: 'newspaper', section: true %>
      </li>
      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Reseñas', admin_reviews_path, icon: 'comments', badge: badges[:reviews] %>
      </li>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Comentarios', admin_comments_path, icon: 'message', badge: badges[:comments] %>
      </li>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Análisis</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Reportes', admin_reports_path, icon: 'chart-pie', section: true %>
      </li>
      <li class="nav-item px-2 mb-1">
        <%= admin_sidebar_link 'Registro de visitas', admin_visitor_logs_path, icon: 'chart-line' %>
      </li>

      <li class="sidebar-section-title px-3 pt-3 pb-1">Sistema</li>

      <li class="nav-item px-2">
        <%= admin_sidebar_link 'Configuración', admin_settings_path, icon: 'gears', section: true,
                               also: [admin_payment_methods_path, admin_shipping_methods_path, admin_system_variables_path,
                                      admin_inventory_audit_path, admin_inventory_events_path, admin_api_keys_path,
                                      admin_api_guide_path, admin_api_guide_reference_path] %>
      </li>
    </ul>
  </nav>

  <%# Footer con usuario %>
  <div class="sidebar-footer border-top border-secondary-subtle px-2 py-2 mt-auto">
    <% if current_user %>
      <% sidebar_user_label = current_user.name.presence || current_user.email.split('@').first %>
      <%= link_to edit_admin_user_path(current_user),
                  class: "text-decoration-none d-flex align-items-center gap-2 sidebar-user-link",
                  aria: { label: "Editar perfil de #{sidebar_user_label}" } do %>
        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mx-auto sidebar-user-avatar">
          <i class="fa-solid fa-circle-user text-white small" aria-hidden="true"></i>
        </div>
        <div class="sidebar-label overflow-hidden">
          <div class="text-white small fw-medium text-truncate"><%= sidebar_user_label %></div>
          <div class="text-secondary small text-truncate"><%= admin_role_label(current_user.role) %></div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
