<%# Panel del lote: lo que el operador está por dejar en el estante, todavía sin
    tocar la base. Turbo reemplaza SÓLO este bloque al agregar, editar, quitar o
    vaciar, así la búsqueda, sus resultados y el scroll quedan intactos.

    Nunca debe confundirse con "Actualmente en esta ubicación": eso ya está
    guardado, esto no. De ahí el encabezado y el icono distintos. %>
<div id="location-batch-panel">
  <div class="card shadow-sm border-primary">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
      <h2 class="h6 mb-0">
        <i class="fa-solid fa-list-check me-1 text-primary" aria-hidden="true"></i>
        Paso 3 · Por asignar
      </h2>
      <span class="badge bg-primary" id="batch-units"><%= batch.total_units %> pieza(s)</span>
    </div>
    <div class="card-body py-2">
      <% if batch.location %>
        <p class="text-muted mb-2" style="font-size:.75rem;">
          Se dejará en <strong><%= batch.location.full_path %></strong> al confirmar.
        </p>
      <% end %>

      <% if batch_lines.empty? %>
        <p class="text-muted small mb-0" id="batch-empty">
          Aún no agregas productos. Busca uno y pulsa <strong>Agregar</strong>.
        </p>
      <% else %>
        <ul class="list-group list-group-flush mb-2" id="batch-lines">
          <% batch_lines.each do |line| %>
            <li class="list-group-item px-0 py-2" data-batch-product-id="<%= line[:product].id %>">
              <div class="d-flex align-items-center gap-2">
                <%= render 'admin/shared/product_thumb', product: line[:product], size: 40 %>
                <div class="flex-grow-1" style="min-width:0;">
                  <div class="small fw-semibold text-truncate"><%= line[:product].product_name %></div>
                  <div class="font-monospace text-muted" style="font-size:.72rem;"><%= line[:product].product_sku %></div>
                </div>
                <%= form_with url: admin_location_assignment_batch_line_path(product_id: line[:product].id),
                              method: :patch, local: true,
                              class: 'd-flex align-items-center gap-1' do %>
                  <%= hidden_field_tag :q, q %>
                  <%= number_field_tag :quantity, line[:quantity], min: 1, step: 1,
                                       class: 'form-control form-control-sm', style: 'width:4.25rem;',
                                       id: "batch-qty-#{line[:product].id}",
                                       'aria-label': "Cantidad de #{line[:product].product_name} en el lote" %>
                  <%= submit_tag 'OK', class: 'btn btn-sm btn-outline-secondary',
                                 id: "batch-update-#{line[:product].id}",
                                 'aria-label': "Actualizar la cantidad de #{line[:product].product_name}" %>
                <% end %>
                <%= button_to admin_location_assignment_batch_remove_line_path(product_id: line[:product].id),
                              method: :delete,
                              params: { q: q },
                              class: 'btn btn-sm btn-outline-danger',
                              id: "batch-remove-#{line[:product].id}",
                              'aria-label': "Quitar #{line[:product].product_name} de la asignación" do %>
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>

        <div class="d-flex justify-content-between text-muted mb-2" style="font-size:.78rem;">
          <span id="batch-products"><%= batch.product_count %> producto(s)</span>
          <span><strong><%= batch.total_units %></strong> pieza(s) en total</span>
        </div>

        <div class="d-grid gap-2">
          <%= link_to admin_location_assignment_batch_review_path(q: q.presence), class: 'btn btn-primary', id: 'review-batch' do %>
            <i class="fa-solid fa-list-check me-1" aria-hidden="true"></i> Revisar asignación
          <% end %>
          <%= button_to admin_location_assignment_batch_clear_path, method: :delete,
                        params: { q: q },
                        class: 'btn btn-sm btn-outline-secondary', id: 'clear-batch' do %>
            <i class="fa-solid fa-trash me-1" aria-hidden="true"></i> Vaciar lote
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
