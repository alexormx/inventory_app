<div class="container-fluid px-0" id="location-batch-page">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
      <h1 class="h4 mb-1">
        <i class="fa-solid fa-boxes-stacked me-2" aria-hidden="true"></i>Ubicar inventario
      </h1>
      <p class="text-muted small mb-0">
        Elige el estante donde estás trabajando y ve agregando lo que acomodes ahí.
      </p>
    </div>
    <%= link_to admin_inventory_verifications_path, class: 'btn btn-sm btn-outline-secondary' do %>
      <i class="fa-solid fa-clipboard-check me-1" aria-hidden="true"></i> Verificación de unidad individual
    <% end %>
  </div>

  <%# Cifras de contexto: compactas, no son el trabajo de esta pantalla. %>
  <div class="row g-2 mb-3">
    <div class="col-4">
      <div class="card border-primary h-100"><div class="card-body text-center py-2">
        <div class="fs-4 fw-bold text-primary lh-1" id="total-assignable"><%= number_with_delimiter(@total_assignable) %></div>
        <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-warehouse me-1" aria-hidden="true"></i>Piezas sin ubicar</div>
      </div></div>
    </div>
    <div class="col-4">
      <div class="card h-100"><div class="card-body text-center py-2">
        <div class="fs-4 fw-bold lh-1" id="total-products"><%= number_with_delimiter(@total_products) %></div>
        <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-cubes me-1" aria-hidden="true"></i>Productos</div>
      </div></div>
    </div>
    <div class="col-4">
      <div class="card h-100 <%= 'border-info' if @total_in_transit.positive? %>"><div class="card-body text-center py-2">
        <div class="fs-4 fw-bold text-info lh-1" id="total-in-transit"><%= number_with_delimiter(@total_in_transit) %></div>
        <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-truck me-1" aria-hidden="true"></i>Pre apartado / en tránsito</div>
      </div></div>
    </div>
  </div>

  <div class="row g-3">
    <%# ============ IZQUIERDA: dónde estoy y qué traigo en la mano ============ %>
    <div class="col-12 col-xl-7">
      <%= render 'admin/inventory/selected_location_panel',
                 batch: @batch, location_options: @location_options, q: @q %>

      <div class="card shadow-sm" id="product-search-panel">
        <div class="card-header py-2">
          <h2 class="h6 mb-0">
            <i class="fa-solid fa-magnifying-glass me-1" aria-hidden="true"></i>
            Paso 2 · Busca lo que estás acomodando
          </h2>
        </div>
        <div class="card-body py-2">
          <%= form_with url: admin_inventory_unlocated_path, method: :get, local: true,
                        class: 'row g-2 align-items-end mb-2' do %>
            <div class="col-12 col-md-9">
              <%= label_tag :q, 'Producto o SKU', class: 'form-label fw-semibold small mb-1' %>
              <%= search_field_tag :q, @q, class: 'form-control', id: 'product-search',
                                   placeholder: 'Ej. Skyline o TOM-123', autocomplete: 'off',
                                   autofocus: @batch.location.present? && @q.blank? %>
            </div>
            <div class="col-12 col-md-3 d-grid">
              <%= submit_tag 'Buscar', class: 'btn btn-outline-primary' %>
            </div>
          <% end %>

          <%= render 'admin/inventory/product_search_results',
                     search_results: @search_results, batch: @batch, q: @q %>
        </div>
      </div>
    </div>

    <%# ============ DERECHA: qué hay aquí ya, y qué estoy por dejar ============ %>
    <div class="col-12 col-xl-5">
      <div class="sticky-xl-top" style="top:1rem;">
        <%= render 'admin/inventory/location_current_inventory', location_inventory: @location_inventory %>
        <%= render 'admin/inventory/location_batch_panel', batch: @batch, batch_lines: @batch_lines, q: @q %>
      </div>
    </div>
  </div>
</div>
