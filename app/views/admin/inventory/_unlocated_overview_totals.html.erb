<div class="row g-2 mb-3"
     id="unlocated-overview-totals"
     data-total-assignable="<%= total_assignable %>"
     data-total-products="<%= total_products %>"
     data-total-in-transit="<%= total_in_transit %>">
  <div class="col-4">
    <div class="card border-primary h-100"><div class="card-body text-center py-2">
      <div class="fs-4 fw-bold text-primary lh-1" id="total-assignable"><%= number_with_delimiter(total_assignable) %></div>
      <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-warehouse me-1" aria-hidden="true"></i>Piezas sin ubicar</div>
    </div></div>
  </div>
  <div class="col-4">
    <div class="card h-100"><div class="card-body text-center py-2">
      <div class="fs-4 fw-bold lh-1" id="total-products"><%= number_with_delimiter(total_products) %></div>
      <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-cubes me-1" aria-hidden="true"></i>Productos</div>
    </div></div>
  </div>
  <div class="col-4">
    <div class="card h-100 <%= 'border-info' if total_in_transit.positive? %>"><div class="card-body text-center py-2">
      <div class="fs-4 fw-bold text-info lh-1" id="total-in-transit"><%= number_with_delimiter(total_in_transit) %></div>
      <div class="text-muted" style="font-size:.75rem;"><i class="fa-solid fa-truck me-1" aria-hidden="true"></i>Pre apartado / en tránsito</div>
    </div></div>
  </div>
</div>
