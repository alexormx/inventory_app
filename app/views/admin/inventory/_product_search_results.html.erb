<%# Resultados de la búsqueda. Turbo los repinta al cambiar de ubicación —de eso
    depende que el botón Agregar esté vivo— pero NO al agregar al lote: ahí el
    término, las filas y el scroll se quedan exactamente como estaban. %>
<div id="product-search-results">
  <% if q.blank? %>
    <p class="text-muted small mb-0">Escribe el nombre o el SKU para encontrar el producto.</p>
  <% elsif search_results.empty? %>
    <p class="text-muted small mb-0">Ningún producto sin ubicar coincide con “<%= q %>”.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0" id="search-results-table">
        <thead class="table-light">
          <tr>
            <th scope="col">Producto</th>
            <th scope="col" class="text-end">Disp.</th>
            <th scope="col" class="text-end">Apart.</th>
            <th scope="col" class="text-end">Asignable</th>
            <th scope="col" style="width:88px;">Cantidad</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% search_results.each do |row| %>
            <% product = row[:product] %>
            <% form_id = "add-form-#{product.id}" %>
            <% assignable = row[:assignable] %>
            <% blocked = assignable.zero? || batch.location.blank? %>
            <tr data-product-id="<%= product.id %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <%= render 'admin/shared/product_thumb', product: product, size: 48 %>
                  <div style="min-width:0;">
                    <div class="fw-semibold text-truncate" style="max-width:13rem;"><%= product.product_name %></div>
                    <div class="d-flex align-items-center gap-1">
                      <span class="font-monospace text-muted" style="font-size:.72rem;"><%= product.product_sku %></span>
                      <%# En tránsito va aquí y no en su propia columna: es un dato
                          del producto, aparece pocas veces y una columna fija para
                          él obligaba a hacer scroll horizontal en la tabla. %>
                      <% if row[:in_transit].positive? %>
                        <span class="badge text-bg-info" style="font-size:.62rem;"
                              title="Pre apartado: sigue en tránsito, no es asignable">
                          <i class="fa-solid fa-truck me-1" aria-hidden="true"></i><%= row[:in_transit] %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </td>
              <td class="text-end"><%= row[:available] %></td>
              <td class="text-end"><%= row[:reserved] %></td>
              <td class="text-end fw-bold" data-assignable="<%= assignable %>"><%= assignable %></td>
              <td>
                <%# Un <form> no puede ser hijo de <tr>: los controles se
                    enlazan al form de abajo con el atributo form=. %>
                <% retried = params[:retry_product_id].to_s == product.id.to_s %>
                <%# La cantidad arranca en 1 cuando hay algo que asignar. Si se deja
                    vacía, el campo es required y el navegador bloquea el envío sin
                    señalar el botón: para el operador "Agregar" parece muerto. %>
                <% default_quantity = retried ? params[:retry_quantity] : (1 if assignable.positive?) %>
                <%= number_field_tag :quantity, default_quantity,
                                     min: 1, max: assignable, step: 1,
                                     class: 'form-control form-control-sm', id: "quantity-#{product.id}",
                                     form: form_id, required: true,
                                     disabled: blocked,
                                     'aria-label': "Cantidad de #{product.product_name} a agregar al lote" %>
              </td>
              <td>
                <%# El nombre visible es "Agregar" en todas las filas; el lector de
                    pantalla necesita saber a cuál producto pertenece. %>
                <%= submit_tag 'Agregar', class: 'btn btn-sm btn-success', id: "add-#{product.id}",
                               form: form_id, disabled: blocked,
                               'aria-label': "Agregar #{product.product_name} al lote" %>
                <%# Un botón apagado sin explicación se lee como una falla. %>
                <% if assignable.zero? %>
                  <div class="text-muted mt-1" style="font-size:.72rem;" id="no-stock-<%= product.id %>">
                    Sin inventario disponible para asignar
                  </div>
                <% elsif batch.location.blank? %>
                  <div class="text-muted mt-1" style="font-size:.72rem;" id="no-location-<%= product.id %>">
                    Selecciona primero la ubicación destino
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% search_results.each do |row| %>
      <%# Con Turbo activo la respuesta es un stream que sólo toca el lote. %>
      <%= form_with url: admin_location_assignment_batch_lines_path, method: :post, local: true,
                    id: "add-form-#{row[:product].id}" do %>
        <%= hidden_field_tag :product_id, row[:product].id, id: "add-product-#{row[:product].id}" %>
        <%= hidden_field_tag :q, q, id: "add-q-#{row[:product].id}" %>
      <% end %>
    <% end %>
  <% end %>
</div>
