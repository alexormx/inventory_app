<%# Resultados de la búsqueda. Turbo los repinta al cambiar de ubicación —de eso
    depende que los botones estén vivos— y al asignar el lote, porque entonces el
    inventario asignable de verdad bajó. Al agregar al lote sólo se repinta la
    fila tocada: término, resto de filas y scroll se quedan como estaban. %>
<% pending_map = batch.pending_map %>
<div id="product-search-results">
  <% if q.blank? %>
    <p class="text-muted small mb-0">Escribe el nombre o el SKU para encontrar el producto.</p>
  <% elsif search_results.empty? %>
    <p class="text-muted small mb-0">Ningún producto sin ubicar coincide con “<%= q %>”.</p>
  <% else %>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle mb-0" id="search-results-table">
        <thead class="table-light">
          <tr>
            <th scope="col">Producto</th>
            <th scope="col" class="text-end text-nowrap">Inventario</th>
            <th scope="col" style="width:84px;">Cantidad</th>
            <th scope="col"></th>
          </tr>
        </thead>
        <tbody>
          <% search_results.each do |row| %>
            <%= render 'admin/inventory/product_search_row',
                       row: row, batch: batch, q: q,
                       pending: pending_map[row[:product].id].to_i %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%# Un <form> no puede ser hijo de <tr>: los controles se enlazan con form=. %>
    <% search_results.each do |row| %>
      <%= form_with url: admin_location_assignment_batch_lines_path, method: :post, local: true,
                    id: "add-form-#{row[:product].id}" do %>
        <%= hidden_field_tag :product_id, row[:product].id, id: "add-product-#{row[:product].id}" %>
        <%= hidden_field_tag :q, q, id: "add-q-#{row[:product].id}" %>
      <% end %>
      <%= form_with url: admin_location_assignment_batch_add_all_lines_path(product_id: row[:product].id),
                    method: :post, local: true, id: "add-all-form-#{row[:product].id}" do %>
        <%= hidden_field_tag :q, q, id: "add-all-q-#{row[:product].id}" %>
      <% end %>
    <% end %>
  <% end %>
</div>
