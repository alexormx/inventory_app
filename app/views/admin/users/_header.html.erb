<div class="d-flex align-items-center justify-content-between mb-4">
  <div class="d-flex align-items-center gap-3">
    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold <%= admin_user_role_badge_class(@user.role) %>" style="width: 60px; height: 60px; font-size: 1.5rem;">
      <%= admin_user_initials(@user) %>
    </div>

    <div>
      <h1 class="h3 mb-1"><%= @user.name %></h1>
      <div class="d-flex gap-2 flex-wrap">
        <span class="badge <%= admin_user_role_badge_class(@user.role) %>">
          <i class="fa-solid fa-<%= admin_user_role_icon(@user.role) %> me-1"></i>
          <%= @user.role.capitalize %>
        </span>
        <% if @user.role == 'customer' && @user.credit_enabled %>
          <span class="badge bg-success" title="Crédito habilitado"><i class="fa-solid fa-credit-card me-1"></i>Crédito</span>
        <% end %>
        <% if @user.role == 'customer' && @total_sales.to_f >= 10000 %>
          <span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i>VIP</span>
        <% end %>
        <% if @balance_due.to_f > 0 %>
          <span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i>Con Adeudo</span>
        <% end %>
        <% if @user.created_at > 14.days.ago %>
          <span class="badge bg-success"><i class="fa-solid fa-sparkles me-1"></i>Nuevo</span>
        <% end %>
      </div>
    </div>
  </div>

  <div class="d-flex gap-2">
    <%= link_to edit_admin_user_path(@user), class: "btn btn-outline-primary" do %>
      <i class="fa-solid fa-pen-to-square me-1"></i>Editar
    <% end %>
    <%= link_to admin_users_path, class: "btn btn-secondary" do %>
      <i class="fa-solid fa-arrow-left me-1"></i>Volver
    <% end %>
  </div>
</div>
