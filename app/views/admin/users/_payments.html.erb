<% if @user.role == 'customer' %>
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0">
      <h5 class="mb-0"><i class="fa-solid fa-money-bill-wave me-2 text-primary"></i>Pagos Recientes</h5>
    </div>
    <% if @recent_payments.any? %>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Orden</th>
                <th>Método</th>
                <th>Fecha</th>
                <th>Estado</th>
                <th class="text-end">Monto</th>
              </tr>
            </thead>
            <tbody>
              <% @recent_payments.each do |payment| %>
                <tr>
                  <td class="text-nowrap">
                    <%= link_to admin_sale_order_path(payment.sale_order), class: "text-decoration-none fw-medium" do %>
                      #<%= payment.sale_order_id %>
                    <% end %>
                  </td>
                  <td><%= payment.payment_method.to_s.humanize %></td>
                  <td class="text-muted"><%= l(payment.paid_at || payment.created_at, format: :short) %></td>
                  <td>
                    <span class="badge <%= payment_status_badge_class(payment.status) %>"><%= payment.status %></span>
                  </td>
                  <td class="text-end"><%= number_to_currency(payment.amount, unit: '$', precision: 0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% else %>
      <div class="card-body text-center py-4">
        <i class="fa-solid fa-money-bill-wave fa-2x text-muted opacity-25 mb-2"></i>
        <p class="text-muted mb-0">Sin pagos registrados</p>
      </div>
    <% end %>
  </div>
<% end %>
