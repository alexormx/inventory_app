<div class="card border-0 shadow-sm mb-4" id="products-sold">
  <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><i class="fa-solid fa-box-open me-2 text-primary"></i>Productos Vendidos</h5>
    <small class="text-muted"><%= pluralize(@products_sold.size, 'producto', plural: 'productos') %> · sin canceladas</small>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
      <table class="table table-hover table-sm mb-0 align-middle">
        <thead class="table-light sticky-top">
          <tr>
            <th class="ps-3">Producto</th>
            <th class="text-end">Piezas</th>
            <th class="text-end">Órdenes</th>
            <th class="text-end">Vendido</th>
            <th class="text-end pe-3">Última compra</th>
          </tr>
        </thead>
        <tbody>
          <% @products_sold.each do |row| %>
            <tr>
              <td class="ps-3">
                <div class="d-flex align-items-center gap-2">
                  <% product = @products_sold_by_id[row.product_id] %>
                  <%= render 'admin/shared/product_thumb', product: product, size: 40 if product %>
                  <div>
                    <%= link_to row.product_name, admin_product_path(row.slug.presence || row.product_id), class: "text-decoration-none fw-medium" %>
                    <% if row.whatsapp_code.present? %>
                      <span class="badge bg-light text-dark border font-monospace ms-1"><%= row.whatsapp_code %></span>
                    <% end %>
                  </div>
                </div>
              </td>
              <td class="text-end"><%= row.units %></td>
              <td class="text-end"><%= row.orders_count %></td>
              <td class="text-end"><%= number_to_currency(row.revenue, unit: '$', precision: 0) %></td>
              <td class="text-end pe-3 text-muted"><%= l(row.last_sold_at.to_date, format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
