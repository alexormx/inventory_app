<h2 class="mb-3 d-flex align-items-center gap-2">
  <i class="fa-solid fa-key"></i> Claves de API
</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
  <p class="text-muted mb-0">Claves para que otras apps (como KataFrame) usen la API. Revocar una clave la desactiva al instante sin afectar a las demás.</p>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to admin_api_guide_path, class: "btn btn-outline-secondary" do %>
      <i class="fa-solid fa-book me-1"></i> Guía de la API
    <% end %>
    <%= link_to new_admin_api_key_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-plus me-1"></i> Nueva clave
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Nombre</th>
            <th>Clave</th>
            <th>Permisos</th>
            <th>Creada</th>
            <th>Último uso</th>
            <th class="text-center">Estado</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @api_keys.any? %>
            <% @api_keys.each do |key| %>
              <tr class="<%= 'table-secondary text-muted' if key.revoked? %>">
                <td><strong><%= key.name %></strong></td>
                <td><code><%= key.token_prefix %>…</code></td>
                <td>
                  <% key.scopes.each do |scope| %>
                    <span class="badge bg-light text-dark border"><%= scope_label(scope) %></span>
                  <% end %>
                </td>
                <td>
                  <%= l(key.created_at, format: :short) %>
                  <br><small class="text-muted"><%= key.created_by&.email %></small>
                </td>
                <td><%= key.last_used_at ? l(key.last_used_at, format: :short) : 'Nunca' %></td>
                <td class="text-center">
                  <% if key.revoked? %>
                    <span class="badge bg-secondary">Revocada</span>
                  <% else %>
                    <span class="badge bg-success">Activa</span>
                  <% end %>
                </td>
                <td class="text-end">
                  <% unless key.revoked? %>
                    <%= button_to 'Revocar', revoke_admin_api_key_path(key), method: :patch,
                                  class: 'btn btn-sm btn-outline-danger',
                                  form: { data: { turbo_confirm: "¿Revocar «#{key.name}»? Las apps que la usan dejarán de conectarse." } } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="7" class="text-center text-muted py-4">Todavía no hay claves.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
