<div class="container-fluid px-0">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <div class="text-muted small text-uppercase fw-semibold">Confirmación por unidad</div>
      <h1 class="h3 mb-0">Inventory #<%= @inventory.id %></h1>
    </div>
    <%= link_to admin_inventory_verifications_path, class: 'btn btn-outline-secondary' do %>
      <i class="fa-solid fa-arrow-left me-1"></i> Volver a la búsqueda
    <% end %>
  </div>

  <% if @error_message.present? %>
    <div class="alert alert-danger" role="alert">
      <i class="fa-solid fa-circle-exclamation me-1"></i>
      <strong>No se realizó ningún cambio.</strong> <%= @error_message %>
    </div>
  <% end %>

  <section class="card shadow-sm mb-4" aria-labelledby="current-state-title">
    <div class="card-header bg-white">
      <h2 id="current-state-title" class="h5 mb-0">Identificación y estado actual</h2>
    </div>
    <div class="card-body">
      <%= render 'inventory_details', inventory: @inventory %>
    </div>
  </section>

  <% if @inventory.reserved? %>
    <div class="alert alert-warning" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-1"></i>
      <strong>Unidad reservada:</strong>
      el inventario reservado dañado o faltante requiere conciliación a nivel de orden.
      En esta pantalla solo puede confirmarse como encontrado; la reserva y sus vínculos se conservarán.
    </div>
  <% end %>

  <section aria-labelledby="verification-options-title">
    <h2 id="verification-options-title" class="h4 mb-3">Selecciona y confirma el resultado</h2>
    <div class="row g-4">
      <div class="col-12 <%= @inventory.available? ? 'col-xl-4' : 'col-xl-6' %>">
        <%= render 'verification_form',
                   inventory: @inventory,
                   result: 'found',
                   expected_snapshot: @expected_snapshot,
                   location_options: @location_options %>
      </div>
      <% if @inventory.available? %>
        <div class="col-12 col-xl-4">
          <%= render 'verification_form',
                     inventory: @inventory,
                     result: 'damaged',
                     expected_snapshot: @expected_snapshot,
                     location_options: @location_options %>
        </div>
        <div class="col-12 col-xl-4">
          <%= render 'verification_form',
                     inventory: @inventory,
                     result: 'missing',
                     expected_snapshot: @expected_snapshot,
                     location_options: @location_options %>
        </div>
      <% end %>
    </div>
  </section>
</div>
