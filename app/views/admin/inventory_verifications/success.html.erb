<div class="container-fluid px-0">
  <div class="card border-success shadow-sm mx-auto" style="max-width: 960px;">
    <div class="card-header bg-success-subtle border-success py-3">
      <div class="d-flex align-items-center gap-3">
        <i class="fa-solid fa-circle-check fa-2x text-success" aria-hidden="true"></i>
        <div>
          <div class="text-success-emphasis text-uppercase small fw-bold">Verificación registrada</div>
          <h1 class="h3 mb-0">Inventory #<%= @inventory.id %></h1>
        </div>
      </div>
    </div>
    <div class="card-body p-4">
      <h2 class="h5">Unidad relacionada (estado actual)</h2>
      <p class="text-muted small">
        Este estado puede haber cambiado después de la verificación. La auditoría histórica se muestra debajo desde el evento registrado.
      </p>
      <%= render 'inventory_details', inventory: @inventory %>

      <hr class="my-4">

      <h2 class="h5">Auditoría de la verificación</h2>
      <dl class="row mb-0">
        <dt class="col-sm-4">Resultado</dt>
        <dd class="col-sm-8 fw-semibold"><%= inventory_verification_result_label(@event_metadata['result']) %></dd>

        <dt class="col-sm-4">Cambio de estado</dt>
        <dd class="col-sm-8">
          <%= inventory_verification_status_label(@event_metadata['previous_status']) %>
          → <%= inventory_verification_status_label(@event_metadata['new_status']) %>
        </dd>

        <dt class="col-sm-4">Ubicación anterior</dt>
        <dd class="col-sm-8" id="verification-previous-location" data-location-id="<%= @event_metadata['previous_location_id'] %>">
          <%= inventory_verification_location_label(@event_metadata['previous_location_id'], @event_locations) %>
        </dd>

        <dt class="col-sm-4">Ubicación resultante</dt>
        <dd class="col-sm-8" id="verification-new-location" data-location-id="<%= @event_metadata['new_location_id'] %>">
          <%= inventory_verification_location_label(@event_metadata['new_location_id'], @event_locations) %>
        </dd>

        <dt class="col-sm-4">Orden de compra</dt>
        <dd class="col-sm-8"><%= @event_metadata['purchase_order_id'].presence || '—' %></dd>

        <dt class="col-sm-4">Partida de compra</dt>
        <dd class="col-sm-8"><%= @event_metadata['purchase_order_item_id'].presence || '—' %></dd>

        <dt class="col-sm-4">Orden de venta</dt>
        <dd class="col-sm-8"><%= @event_metadata['sale_order_id'].presence || '—' %></dd>

        <dt class="col-sm-4">Partida de venta</dt>
        <dd class="col-sm-8"><%= @event_metadata['sale_order_item_id'].presence || '—' %></dd>

        <dt class="col-sm-4">Verificado por</dt>
        <dd class="col-sm-8"><%= @event_metadata['actor_name'].presence || @event_metadata['actor_email'] %></dd>

        <dt class="col-sm-4">Fecha del evento</dt>
        <dd class="col-sm-8"><%= l(@event.created_at, format: :short) %></dd>

        <% if @event_metadata['notes'].present? %>
          <dt class="col-sm-4">Notas</dt>
          <dd class="col-sm-8"><%= @event_metadata['notes'] %></dd>
        <% end %>
      </dl>
    </div>
    <div class="card-footer bg-white d-flex flex-column flex-sm-row gap-2 justify-content-end p-3">
      <%= link_to 'Ver producto', admin_product_path(@inventory.product), class: 'btn btn-outline-secondary' %>
      <%= link_to 'Volver a verificación física', admin_inventory_verifications_path, class: 'btn btn-primary' %>
    </div>
  </div>
</div>
