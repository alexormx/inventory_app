<div class="container-fluid px-0">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1"><i class="fa-solid fa-clipboard-check me-2"></i>Verificación física</h1>
      <p class="text-muted mb-0">Busca y confirma una unidad exacta de inventario a la vez.</p>
    </div>
    <%= link_to admin_inventory_location_explorer_path(mode: 'unlocated'), class: 'btn btn-outline-secondary' do %>
      <i class="fa-solid fa-map-location-dot me-1"></i> Explorar inventario sin ubicación
    <% end %>
  </div>

  <div class="alert alert-info d-flex gap-2" role="status">
    <i class="fa-solid fa-shield-halved mt-1" aria-hidden="true"></i>
    <div>
      <strong>Siempre por unidad exacta:</strong> cada escritura usa un Inventory ID concreto.
      Puedes seleccionar varias unidades para asignarles la misma ubicación, pero
      nunca se asigna por producto y cantidad ni se eligen piezas automáticamente por FIFO.
      <span class="d-block mt-1"><%= number_with_delimiter(@candidate_count) %> unidades requieren revisión.</span>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: admin_inventory_verifications_path, method: :get, local: true, class: 'row g-3 align-items-end' do %>
        <div class="col-12 col-md-4">
          <%= label_tag :search_by, 'Buscar por', class: 'form-label fw-semibold' %>
          <%= select_tag :search_by, options_for_select(@search_options, @search_by), class: 'form-select form-select-lg' %>
        </div>
        <div class="col-12 col-md-6">
          <%= label_tag :q, 'Identificador o texto', class: 'form-label fw-semibold' %>
          <%= search_field_tag :q, @query, class: 'form-control form-control-lg', placeholder: 'Ej. 19445, SKU, producto, PO o SO', autocomplete: 'off' %>
        </div>
        <div class="col-12 col-md-2 d-grid">
          <%= submit_tag 'Buscar unidad', class: 'btn btn-primary btn-lg' %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h5 mb-0"><%= @query.present? ? 'Resultados' : 'Unidades pendientes' %></h2>
    <% if @query.present? %>
      <%= link_to 'Limpiar búsqueda', admin_inventory_verifications_path, class: 'btn btn-sm btn-outline-secondary' %>
    <% end %>
  </div>

  <% if @inventories.any? %>
<%# turbo: false porque este paso responde con una pantalla de revisión (200) en %>
    <%# lugar de redirigir; Turbo sólo acepta redirecciones al enviar formularios. %>
    <%= form_with url: bulk_review_admin_inventory_verifications_path,
                  method: :post,
                  local: true,
                  id: 'bulk-assign-form',
                  data: { controller: 'bulk-verification', turbo: false } do %>
      <div class="card shadow-sm mb-3 bulk-assign-toolbar">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
          <div class="form-check mb-0">
            <%= check_box_tag 'select_all_page', '1', false,
                              class: 'form-check-input',
                              id: 'select-all-page',
                              data: { bulk_verification_target: 'selectAll', action: 'change->bulk-verification#toggleAll' } %>
            <%= label_tag 'select-all-page', 'Seleccionar las unidades de esta página', class: 'form-check-label fw-semibold' %>
          </div>
          <span class="badge bg-secondary" data-bulk-verification-target="counter" id="bulk-selected-count">0 seleccionadas</span>
          <button type="button" class="btn btn-sm btn-outline-secondary"
                  data-action="bulk-verification#clear">Limpiar selección</button>
          <div class="ms-auto">
            <%= submit_tag 'Asignar ubicación a la selección',
                           class: 'btn btn-primary btn-lg',
                           id: 'bulk-review-submit',
                           data: { bulk_verification_target: 'submit' } %>
          </div>
        </div>
        <div class="card-footer small text-muted">
          Sólo se envían las unidades marcadas en esta página. La paginación nunca añade unidades que no hayas visto.
        </div>
      </div>

      <div class="row row-cols-1 row-cols-xl-2 g-3 mb-4" id="inventory-verification-results">
        <% @inventories.each do |inventory| %>
          <div class="col">
            <article class="card h-100 shadow-sm <%= 'border-warning' if inventory.reserved? %>" data-inventory-id="<%= inventory.id %>">
              <div class="card-body">
                <% selectable = selectable_for_verification?(inventory) %>
                <% if selectable %>
                  <div class="form-check mb-2">
                    <%= check_box_tag 'inventory_ids[]', inventory.id, false,
                                      class: 'form-check-input bulk-unit-checkbox',
                                      id: "inventory-select-#{inventory.id}",
                                      data: { bulk_verification_target: 'unit', action: 'change->bulk-verification#refresh' } %>
                    <%= label_tag "inventory-select-#{inventory.id}", "Seleccionar ##{inventory.id}", class: 'form-check-label fw-semibold' %>
                  </div>
                <% else %>
                  <%# Se lista para que el backlog cuadre con el contador del panel,
                      pero no se puede verificar: la pieza aún viene en tránsito. %>
                  <div class="form-check mb-2">
                    <%= check_box_tag 'inventory_ids[]', inventory.id, false,
                                      class: 'form-check-input',
                                      id: "inventory-select-#{inventory.id}",
                                      disabled: true,
                                      aria: { describedby: "inventory-blocked-#{inventory.id}" } %>
                    <%= label_tag "inventory-select-#{inventory.id}", "No seleccionable ##{inventory.id}", class: 'form-check-label text-muted' %>
                  </div>
                  <p class="small text-muted mb-2" id="inventory-blocked-<%= inventory.id %>">
                    <i class="fa-solid fa-truck me-1" aria-hidden="true"></i>
                    <%= inventory_verification_status_label(inventory.status) %>:
                    la pieza sigue en tránsito, así que todavía no puede verificarse físicamente.
                  </p>
                <% end %>
                <%= render 'inventory_details', inventory: inventory %>
                <hr>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                  <div class="small text-muted">
                    Creado <%= l(inventory.created_at, format: :short) %>
                    · Costo <%= number_to_currency(inventory.purchase_cost, unit: '$') %>
                  </div>
                  <%= link_to admin_inventory_verification_path(inventory), class: 'btn btn-outline-primary' do %>
                    Verificar #<%= inventory.id %> <i class="fa-solid fa-arrow-right ms-1"></i>
                  <% end %>
                </div>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% end %>
    <div class="d-flex justify-content-center"><%= paginate @inventories %></div>
  <% else %>
    <div class="card border-0 bg-light">
      <div class="card-body text-center py-5">
        <i class="fa-solid fa-magnifying-glass fa-2x text-muted mb-3"></i>
        <h2 class="h5">No se encontraron unidades elegibles</h2>
        <p class="text-muted mb-0">Revisa el tipo de búsqueda y confirma que la unidad siga sin ubicación.</p>
      </div>
    </div>
  <% end %>
</div>
