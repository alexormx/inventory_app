<%# Agregar toca el lote y la fila del producto agregado, nada más. La búsqueda
    no se repinta: término, resto de filas y scroll se quedan como estaban. El
    resumen de la ubicación tampoco, porque estas piezas aún NO se han asignado:
    sólo una asignación confirmada mueve "Actualmente en esta ubicación". %>
<%= turbo_stream.replace 'location-batch-panel' do %>
  <%= render 'admin/inventory/location_batch_panel', batch: @batch, batch_lines: @batch_lines, q: @q %>
<% end %>
<%= turbo_stream.replace "result-row-#{@added_product.id}" do %>
  <%= render 'admin/inventory/product_search_row',
             row: @added_row, batch: @batch, q: @q,
             pending: @batch.pending_for(@added_product.id) %>
<% end %>
<%= render 'flash_streams' %>
