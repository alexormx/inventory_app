<div class="container-fluid px-0" id="batch-review">
  <h1 class="h3 mb-4">
    <i class="fa-solid fa-list-check me-2" aria-hidden="true"></i>Revisar asignación
  </h1>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="text-muted small">Ubicación</div>
      <div class="h4 mb-0" id="review-location">
        <i class="fa-solid fa-location-dot me-1 text-primary" aria-hidden="true"></i>
        <%= @location.full_path %>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-header"><h2 class="h6 mb-0">Productos</h2></div>
    <div class="table-responsive">
      <table class="table align-middle mb-0" id="review-lines">
        <thead class="table-light">
          <tr>
            <th scope="col">Producto</th>
            <th scope="col">SKU</th>
            <th scope="col" class="text-end">Cantidad</th>
          </tr>
        </thead>
        <tbody>
          <% @lines.each do |line| %>
            <tr data-review-product-id="<%= line[:product].id %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <%= render 'admin/shared/product_thumb', product: line[:product], size: 44 %>
                  <span class="fw-semibold"><%= line[:product].product_name %></span>
                </div>
              </td>
              <td class="font-monospace small"><%= line[:product].product_sku %></td>
              <td class="text-end fw-bold"><%= line[:quantity] %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="table-light">
          <tr>
            <th scope="row" colspan="2" class="text-end">Total</th>
            <th class="text-end" id="review-total"><%= @total_units %> piezas</th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <div class="d-flex flex-wrap gap-2">
    <%= link_to admin_inventory_unlocated_path(q: @q.presence), class: 'btn btn-outline-secondary btn-lg', id: 'review-back' do %>
      <i class="fa-solid fa-arrow-left me-1" aria-hidden="true"></i> Regresar
    <% end %>
    <%= button_to admin_location_assignment_batch_confirm_path, method: :post,
                  form: { data: { turbo: false } },
                  class: 'btn btn-success btn-lg', id: 'confirm-batch' do %>
      <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
      Confirmar asignación de <%= @total_units %> pieza(s)
    <% end %>
  </div>
</div>
