<%#
  Parcial KPI Card
  Props:
    - title: String (etiqueta superior)
    - value: String (valor principal ya formateado)
    - ly: String opcional (texto LY u otro comparativo)
    - delta: Numeric opcional (ratio -1..1); colorea verde/rojo
    - delta_unit: 'pp' opcional; el delta es una diferencia de puntos porcentuales, no un cambio relativo
    - variant: String (Bootstrap card variant e.g. text-bg-success-subtle)
    - spark_data: Array opcional con la serie de los últimos 12 meses (mini-gráfica)
    - tooltip: String opcional (texto de ayuda)
    - health: String opcional ('good', 'warning', 'danger') para indicador de salud
%>
<% health_class = case local_assigns[:health]
                  when 'good' then 'border-success border-2'
                  when 'warning' then 'border-warning border-2'
                  when 'danger' then 'border-danger border-2'
                  else ''
                  end %>
<div class="card admin-kpi-card <%= variant.presence || 'text-bg-light' %> h-100 <%= health_class %>"
     <% if local_assigns[:tooltip].present? %>data-bs-toggle="tooltip" data-bs-placement="top" title="<%= local_assigns[:tooltip] %>"<% end %>>
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start gap-2">
      <div>
        <div class="kpi-label small text-muted d-flex align-items-center gap-1">
          <%= title %>
          <% if local_assigns[:tooltip].present? %>
            <i class="fa-solid fa-circle-info text-muted kpi-info-icon"></i>
          <% end %>
        </div>
        <div class="kpi-value fs-4 fw-bold">
          <%= value %>
          <% if local_assigns[:ly].present? %>
            <span class="small text-muted">(LY: <%= local_assigns[:ly] %>)</span>
          <% end %>
        </div>
        <% if defined?(delta) && !delta.nil? %>
          <div class="kpi-delta small <%= delta.to_f >= 0 ? 'text-success' : 'text-danger' %>">
            <i class="fa-solid <%= delta.to_f >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' %>"></i>
            <% if local_assigns[:delta_unit] == 'pp' %>
              vs LY: <%= format('%+.1f', delta.to_f * 100) %> pp
            <% else %>
              vs LY: <%= number_to_percentage(delta.to_f * 100, precision: 1) %>
            <% end %>
          </div>
        <% else %>
          <div class="kpi-delta small text-muted">vs LY: —</div>
        <% end %>
      </div>
      <% if local_assigns[:spark_data].present? %>
        <div class="kpi-sparkline" title="Últimos 12 meses" data-controller="chart" data-chart-type="spark" data-chart-data="<%= local_assigns[:spark_data].map(&:to_f).to_json %>"></div>
      <% end %>
    </div>
  </div>
</div>
