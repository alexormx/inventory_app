<%# locals: funnel: %>
<% sent = funnel[:sent] %>
<% stages = [
     { label: 'Enviadas',   count: sent,               color: 'bg-secondary', rate: nil },
     { label: 'Contactadas', count: funnel[:contacted], color: 'bg-info',      rate: funnel[:contact_rate] },
     { label: 'Convertidas', count: funnel[:converted], color: 'bg-success',   rate: funnel[:conversion_rate] }
   ] %>
<div class="card h-100">
  <div class="card-header py-2 d-flex justify-content-between align-items-center">
    <span class="fw-semibold"><i class="fa-brands fa-whatsapp text-success"></i> Embudo WhatsApp</span>
    <span class="small text-muted" data-bs-toggle="tooltip"
          title="Horas promedio entre el envío de la solicitud y su conversión en orden.">
      <%= funnel[:avg_hours_to_convert].nil? ? '—' : "#{number_with_precision(funnel[:avg_hours_to_convert], precision: 1, delimiter: ',')} h a convertir" %>
    </span>
  </div>
  <div class="card-body py-3">
    <% if sent.zero? %>
      <p class="text-muted small mb-0">Sin solicitudes enviadas en el periodo.</p>
    <% else %>
      <% stages.each do |stage| %>
        <div class="admin-funnel-stage mb-3">
          <div class="d-flex justify-content-between small mb-1">
            <span><%= stage[:label] %></span>
            <span class="fw-semibold">
              <%= fmt_number(stage[:count]) %>
              <% if stage[:rate] %>
                <span class="text-muted fw-normal">· <%= fmt_percentage_ratio(stage[:rate], precision: 1) %></span>
              <% end %>
            </span>
          </div>
          <div class="progress admin-funnel-bar">
            <div class="progress-bar <%= stage[:color] %>"
                 style="width: <%= ((stage[:count].to_d / sent) * 100).to_f.round(2) %>%"></div>
          </div>
        </div>
      <% end %>

      <div class="row g-2 text-center border-top pt-3">
        <div class="col-4">
          <div class="small text-muted" data-bs-toggle="tooltip" title="Convertidas sobre contactadas: qué tan bien cierra el equipo una vez que hay conversación.">Cierre</div>
          <div class="fw-bold"><%= fmt_percentage_ratio(funnel[:close_rate], precision: 1) %></div>
        </div>
        <div class="col-4">
          <div class="small text-muted" data-bs-toggle="tooltip" title="Valor real de las órdenes generadas por este canal, no el estimado que vio el cliente.">Ingreso</div>
          <div class="fw-bold"><%= fmt_currency(funnel[:converted_revenue]) %></div>
        </div>
        <div class="col-4">
          <div class="small text-muted" data-bs-toggle="tooltip" title="Estimado de las solicitudes enviadas o contactadas que aún no se convierten ni se cancelan.">Pipeline</div>
          <div class="fw-bold"><%= fmt_currency(funnel[:pipeline_estimate]) %></div>
        </div>
      </div>

      <% if funnel[:canceled].positive? %>
        <div class="small text-muted mt-2">
          <i class="fa-solid fa-ban text-danger"></i> <%= fmt_number(funnel[:canceled]) %> canceladas
        </div>
      <% end %>
    <% end %>
  </div>
</div>
